# seedbox — secrets rendus par pre_deploy (sops -d secrets/tyron/seedbox.env > .env).
# Les NON-secrets (pays de sortie, ports, port forwarding) sont dans compose.yaml.
#
# Valeurs issues de la config WireGuard générée sur account.protonvpn.com
# (Downloads > WireGuard configuration), avec "NAT-PMP (Port Forwarding)" ACTIVÉ.

# Ligne "PrivateKey" de la section [Interface].
WIREGUARD_PRIVATE_KEY=
# Ligne "Address" de la section [Interface] (IPv4 uniquement : gluetun ignore l'IPv6 ici).
WIREGUARD_ADDRESSES=10.2.0.2/32
